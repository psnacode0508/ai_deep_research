# =============================================================
# DeepResearch — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# -----------------------------------------
# Frontend (apps/web)
# All VITE_ prefixed vars are exposed to the browser build.
# -----------------------------------------

# Supabase project URL (from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (e.g. http://localhost:4000 for local dev)
VITE_API_URL=http://localhost:4000

# -----------------------------------------
# Backend (apps/server)
# These vars are NEVER exposed to the browser.
# -----------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Origin(s) allowed by CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# Supabase project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key — KEEP SECRET, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct database connection string (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------
# AI / Research (added in a future milestone)
# -----------------------------------------

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use (e.g. gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# Tavily Search API key
TAVILY_API_KEY=your-tavily-api-key

# -----------------------------------------
# Background Jobs / Queue (added in a future milestone)
# -----------------------------------------

# Redis connection URL (e.g. redis://localhost:6379 or a managed Redis URL)
REDIS_URL=redis://localhost:6379

# -----------------------------------------
# Security & Rate Limiting
# -----------------------------------------

# Global rate limit window in milliseconds (e.g., 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Global maximum requests per IP within the window
RATE_LIMIT_MAX_REQUESTS=100
